<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0F1116</color>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">#0F1116</item>
        <item name="android:colorAccent">#6EA8FF</item>
    </style>

    <!-- Bare dialog window: the rounded panel inside draws everything itself. -->
    <style name="Sheet" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorAccent">#6EA8FF</item>
    </style>
</resources>
